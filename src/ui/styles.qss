/* BahaaIT Quantum Midnight Design System v2 */

QMainWindow {
    background-color: transparent; /* Needed for rounded corners with TranslucentBackground */
}

#MainContainer {
    background-color: #0F172A;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 16px;
}

#MainContainer[maximized="true"] {
    border-radius: 0px;
    border: none;
}

/* Sidebar Styling */
#Sidebar {
    background-color: #1E293B;
    border-right: 1px solid rgba(255, 255, 255, 0.06);
    min-width: 244px;
    max-width: 244px;
    border-bottom-left-radius: 0px;
}

#SidebarCategory {
    color: #818CF8;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    margin-top: 14px;
    margin-left: 16px;
    margin-bottom: 4px;
    min-height: 18px;
    background: transparent;
}

#MainContent {
    background-color: transparent;
}

#Sidebar QPushButton {
    background-color: transparent;
    color: #E2E8F0;
    text-align: left;
    padding: 7px 12px;
    border: none;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 500;
    margin: 1px 8px;
    min-height: 22px;
    qproperty-iconSize: 18px 18px;
}

#Sidebar QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.09);
    color: #FFFFFF;
}

#Sidebar QPushButton:checked {
    background-color: #4F46E5;
    color: #FFFFFF;
    font-weight: 700;
}

/* Header & Global Stats */
#GlobalHeader {
    background-color: #1E293B;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    min-height: 74px;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
}

#GlobalHeader[maximized="true"] {
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
}

/* Window Control Buttons */
#WindowControl, #WindowControlClose {
    background-color: transparent;
    color: #94A3B8;
    border: none;
    border-radius: 6px;
    padding: 0px;
    font-size: 14px;
    font-weight: 600;
}

#WindowControl:hover {
    background-color: rgba(255, 255, 255, 0.12);
    color: #FFFFFF;
}

#WindowControlClose:hover {
    background-color: #EF4444;
    color: #FFFFFF;
}

#LogoLabel {
    font-size: 26px;
    font-weight: 900;
    color: #FFFFFF;
    padding-left: 10px;
}

/* Status Bar (dark integrated bottom bar) */
QStatusBar {
    background-color: #0B1220;
    color: #94A3B8;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    padding: 2px 14px;
    font-size: 11px;
}

QStatusBar::item {
    border: none;
}

QSizeGrip {
    background: transparent;
    width: 12px;
    height: 12px;
}

/* Cards & Panel Frames */
QFrame#Card,
QFrame#PanelCard,
QFrame#FilterBar,
QFrame#KpiCard {
    background-color: #1E293B;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.08);
}

QFrame#Card:hover {
    border: 1px solid #6366F1;
    background-color: #242F42;
}

/* Global Labels (no margin leak or border inheritance) */
QLabel {
    color: #F1F5F9;
    font-size: 13px;
    background: transparent;
    border: none;
    margin: 0px;
}

#SectionHeader {
    color: #818CF8;
    font-weight: 700;
    font-size: 12px;
    margin-bottom: 6px;
}

#VersionLabel {
    color: #94A3B8;
    font-size: 11px;
}

QLabel#Title {
    font-size: 26px;
    font-weight: 800;
    color: #FFFFFF;
}

QLabel#ValueLabel {
    font-size: 24px;
    font-weight: 800;
    color: #FFFFFF;
}

QLabel#SubTitle {
    font-size: 11px;
    color: #818CF8;
    font-weight: 700;
}

/* Dark QMessageBox & QInputDialog */
QMessageBox, QInputDialog {
    background-color: #0F172A;
    color: #F1F5F9;
}

QMessageBox QLabel#qt_msgbox_label {
    color: #F1F5F9;
    font-size: 13px;
    min-width: 280px;
}

QMessageBox QPushButton, QInputDialog QPushButton {
    background-color: #334155;
    color: #F1F5F9;
    border: 1px solid #475569;
    border-radius: 8px;
    padding: 6px 16px;
    min-width: 80px;
    font-size: 13px;
    font-weight: 600;
}

QMessageBox QPushButton:hover, QInputDialog QPushButton:hover {
    background-color: #4F46E5;
    border-color: #6366F1;
    color: #FFFFFF;
}

/* Unified Button Hierarchy (Default + Primary + Secondary + Danger + Table Compact) */
QPushButton {
    background-color: #1E293B;
    color: #F1F5F9;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #334155;
    border-color: #6366F1;
    color: #FFFFFF;
}

QPushButton:pressed {
    background-color: #4F46E5;
    border-color: #818CF8;
    color: #FFFFFF;
}

QPushButton:disabled {
    background-color: #162032;
    color: #64748B;
    border-color: #1E293B;
}

QPushButton#PrimaryButton, QPushButton[class="PrimaryButton"] {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #4F46E5, stop:1 #6366F1);
    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    padding: 7px 16px;
    font-size: 13px;
    font-weight: 700;
}

QPushButton#PrimaryButton:hover, QPushButton[class="PrimaryButton"]:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #6366F1, stop:1 #4F46E5);
}

QPushButton#PrimaryButton:pressed, QPushButton[class="PrimaryButton"]:pressed {
    background-color: #4338CA;
}

QPushButton#PrimaryButton:disabled, QPushButton[class="PrimaryButton"]:disabled {
    background-color: #1E293B;
    color: #64748B;
    border: 1px solid #334155;
}

QPushButton#SecondaryButton, QPushButton[class="SecondaryButton"] {
    background-color: #334155;
    color: #F1F5F9;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    padding: 7px 16px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#SecondaryButton:hover, QPushButton[class="SecondaryButton"]:hover {
    background-color: #475569;
    border-color: #6366F1;
    color: #FFFFFF;
}

QPushButton#SecondaryButton:pressed, QPushButton[class="SecondaryButton"]:pressed {
    background-color: #3B4961;
}

QPushButton#SecondaryButton:disabled, QPushButton[class="SecondaryButton"]:disabled {
    background-color: #162032;
    color: #64748B;
    border-color: #1E293B;
}

QPushButton#DangerButton, QPushButton[class="DangerButton"] {
    background-color: rgba(244, 63, 94, 0.12);
    color: #FB7185;
    border: 1px solid #F43F5E;
    border-radius: 10px;
    padding: 7px 16px;
    font-size: 13px;
    font-weight: 700;
}

QPushButton#DangerButton:hover, QPushButton[class="DangerButton"]:hover {
    background-color: #F43F5E;
    color: #FFFFFF;
}

QPushButton#DangerButton:disabled, QPushButton[class="DangerButton"]:disabled {
    background-color: #162032;
    color: #64748B;
    border-color: #334155;
}

QPushButton#TableActionButton {
    background-color: #334155;
    color: #F1F5F9;
    border: 1px solid #475569;
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#TableActionButton:hover {
    background-color: #4F46E5;
    border-color: #6366F1;
    color: #FFFFFF;
}

QPushButton#TableDangerButton {
    background-color: transparent;
    color: #FB7185;
    border: 1px solid #F43F5E;
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#TableDangerButton:hover {
    background-color: #F43F5E;
    color: #FFFFFF;
}

QPushButton#IconButton {
    background-color: #334155;
    color: #F1F5F9;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 8px;
    padding: 0px;
    font-size: 15px;
    font-weight: 700;
}

QPushButton#IconButton:hover {
    background-color: #475569;
    border-color: #6366F1;
    color: #FFFFFF;
}

QPushButton#IconButton:pressed {
    background-color: #4F46E5;
    color: #FFFFFF;
}

/* Specific Browser Toolbar Buttons */
#BrowserNav {
    background-color: rgba(255, 255, 255, 0.06);
    color: #F1F5F9;
    font-size: 16px;
    border-radius: 10px;
    padding: 0px;
    margin: 0px;
    border: 1px solid rgba(255, 255, 255, 0.12);
}

#BrowserAddressBar {
    margin: 0px;
    border-radius: 10px;
}

#BrowserNav:hover {
    background-color: rgba(255, 255, 255, 0.16);
    border: 1px solid #6366F1;
    color: #FFFFFF;
}

#BrowserNav:pressed {
    background-color: #4F46E5;
}

#BrowserNav:disabled {
    color: #475569;
    background-color: rgba(255, 255, 255, 0.02);
    border-color: rgba(255, 255, 255, 0.05);
}

/* Inputs & Pickers */
QComboBox {
    background-color: #0F172A;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 5px 10px;
    color: #F1F5F9;
    font-size: 13px;
    min-height: 22px;
}

QComboBox:hover {
    border: 1px solid #6366F1;
}

QComboBox:disabled {
    background-color: #0B1220;
    color: #64748B;
    border-color: #1E293B;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 28px;
    border-left: 1px solid rgba(255, 255, 255, 0.08);
    background-color: rgba(255, 255, 255, 0.02);
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

QComboBox::down-arrow {
    image: url("__ICONS_DIR__/chevron-down.svg");
    width: 12px;
    height: 12px;
}

QComboBox::down-arrow:on {
    image: url("__ICONS_DIR__/chevron-down-active.svg");
}

QComboBox QAbstractItemView {
    background-color: #1E293B;
    color: #F1F5F9;
    selection-background-color: #4F46E5;
    selection-color: #FFFFFF;
    border: 1px solid #475569;
    outline: none;
}

QComboBox QLineEdit {
    background-color: transparent;
    border: none;
    padding: 0px;
    min-height: 0px;
}

QLineEdit {
    background-color: #0F172A;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 5px 10px;
    color: #F1F5F9;
    font-size: 13px;
    min-height: 22px;
    selection-background-color: #6366F1;
}

QLineEdit:hover {
    border: 1px solid #475569;
}

QLineEdit:focus {
    border: 1px solid #6366F1;
    background-color: #162032;
}

QLineEdit:disabled {
    background-color: #0B1220;
    color: #64748B;
    border-color: #1E293B;
}

QSpinBox, QDoubleSpinBox {
    background-color: #0F172A;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 4px 24px 4px 10px;
    color: #F1F5F9;
    font-size: 13px;
    min-height: 24px;
    selection-background-color: #6366F1;
}

QSpinBox:hover, QDoubleSpinBox:hover {
    border: 1px solid #475569;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #6366F1;
    background-color: #162032;
}

QSpinBox:disabled, QDoubleSpinBox:disabled {
    background-color: #0B1220;
    color: #64748B;
    border-color: #1E293B;
}

QSpinBox QLineEdit, QDoubleSpinBox QLineEdit {
    background-color: transparent;
    border: none;
    border-radius: 0px;
    padding: 0px;
    margin: 0px;
    min-height: 0px;
    color: #F1F5F9;
    font-size: 13px;
    selection-background-color: #6366F1;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 22px;
    background: #1E293B;
    border-top-right-radius: 7px;
    border-left: 1px solid #334155;
    border-bottom: 1px solid #334155;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 22px;
    background: #1E293B;
    border-bottom-right-radius: 7px;
    border-left: 1px solid #334155;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
    background: #334155;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url("__ICONS_DIR__/chevron-up-sm.svg");
    width: 10px;
    height: 10px;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url("__ICONS_DIR__/chevron-down-sm.svg");
    width: 10px;
    height: 10px;
}

/* Text Areas & Rich Logs */
QTextEdit, QPlainTextEdit, QTextBrowser {
    background-color: #0B1220;
    color: #E2E8F0;
    border: 1px solid #334155;
    border-radius: 10px;
    padding: 6px;
    selection-background-color: #4F46E5;
    selection-color: #FFFFFF;
}

QTextEdit:disabled, QPlainTextEdit:disabled {
    color: #64748B;
}

/* Dark Trees, Lists & ScrollAreas */
QTreeWidget, QTreeView, QListWidget {
    background-color: #0F172A;
    alternate-background-color: #162032;
    color: #F1F5F9;
    selection-background-color: #4F46E5;
    selection-color: #FFFFFF;
    border: 1px solid #334155;
    border-radius: 10px;
    padding: 4px;
    outline: none;
    font-size: 13px;
}

QTreeWidget::item, QTreeView::item, QListWidget::item {
    padding: 5px 8px;
    border-radius: 5px;
    color: #F1F5F9;
}

QTreeWidget::item:hover, QTreeView::item:hover, QListWidget::item:hover {
    background-color: rgba(99, 102, 241, 0.18);
    color: #FFFFFF;
}

QTreeWidget::item:selected, QTreeWidget::item:selected:active, QTreeWidget::item:selected:!active,
QTreeView::item:selected, QTreeView::item:selected:active, QTreeView::item:selected:!active,
QListWidget::item:selected, QListWidget::item:selected:active, QListWidget::item:selected:!active {
    background-color: #4F46E5;
    color: #FFFFFF;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* Dark QSplitter Handles */
QSplitter::handle {
    background-color: #1E293B;
}

QSplitter::handle:horizontal {
    width: 4px;
}

QSplitter::handle:vertical {
    height: 4px;
}

QSplitter::handle:hover {
    background-color: #6366F1;
}

/* Context Menus */
QMenu {
    background-color: #1E293B;
    color: #F1F5F9;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 20px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #4F46E5;
    color: #FFFFFF;
}

QMenu::separator {
    height: 1px;
    background: #334155;
    margin: 4px 8px;
}

/* Table Design */
QTableWidget {
    background-color: #1E293B;
    alternate-background-color: #162032;
    gridline-color: rgba(255, 255, 255, 0.06);
    border: 1px solid #334155;
    border-radius: 12px;
    color: #F1F5F9;
    selection-background-color: rgba(79, 70, 229, 0.35);
    selection-color: #FFFFFF;
    outline: none;
}

QTableWidget::item {
    padding: 4px 6px;
}

QTableWidget::item:selected {
    background-color: rgba(79, 70, 229, 0.38);
    color: #FFFFFF;
}

QTableWidget::item:hover {
    background-color: rgba(148, 163, 184, 0.08);
}

QTableWidget QAbstractScrollArea::corner, QTableCornerButton::section {
    background-color: #263348;
    border: none;
}

QHeaderView {
    background-color: #263348;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
}

QHeaderView::section {
    background-color: #263348;
    color: #CBD5E1;
    padding: 8px 6px;
    border: none;
    border-bottom: 1px solid #334155;
    font-size: 12px;
    font-weight: 700;
}

/* Progress Bar */
QProgressBar {
    background-color: #334155;
    border-radius: 6px;
    text-align: center;
    color: #FFFFFF;
    font-weight: 700;
    font-size: 12px;
}

QProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #4F46E5, stop:1 #10B981);
    border-radius: 6px;
}

/* Scrollbar Modernization - Floating Slim Look */
QScrollBar:vertical {
    border: none;
    background-color: #0B1220;
    width: 8px;
    margin: 0px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background-color: #334155;
    min-height: 36px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background-color: #4F46E5;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: none;
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
    border: none;
}

QScrollBar:horizontal {
    border: none;
    background-color: #0B1220;
    height: 8px;
    margin: 0px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background-color: #334155;
    min-width: 36px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #4F46E5;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
    border: none;
    width: 0px;
    height: 0px;
}

/* Premium Dark QDialog & QFileDialog Styling */
QDialog, QFileDialog {
    background-color: #0F172A;
    color: #F1F5F9;
}

QFileDialog QWidget {
    background-color: transparent;
    color: #F1F5F9;
}

QFileDialog QFrame {
    background-color: transparent;
    border: none;
}

QFileDialog QLabel {
    color: #94A3B8;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 0px;
}

QFileDialog QListView,
QFileDialog QTreeView {
    background-color: #1E293B;
    alternate-background-color: #162032;
    color: #F1F5F9;
    border: 1px solid #334155;
    border-radius: 12px;
    padding: 6px;
    outline: none;
    font-size: 13px;
    selection-background-color: #4F46E5;
    selection-color: #FFFFFF;
}

QFileDialog QListView#sidebar {
    min-width: 185px;
}

QFileDialog QListView::item,
QFileDialog QTreeView::item {
    padding: 6px 10px;
    border-radius: 6px;
    color: #F1F5F9;
}

QFileDialog QListView::item:hover,
QFileDialog QTreeView::item:hover {
    background-color: rgba(99, 102, 241, 0.18);
    color: #FFFFFF;
}

QFileDialog QListView::item:selected,
QFileDialog QTreeView::item:selected {
    background-color: #4F46E5;
    color: #FFFFFF;
}

QFileDialog QHeaderView {
    background-color: #1E293B;
    border-bottom: 1px solid #334155;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}

QFileDialog QHeaderView::section {
    background-color: #1E293B;
    color: #94A3B8;
    padding: 8px 12px;
    border: none;
    border-bottom: 1px solid #334155;
    font-weight: 700;
    font-size: 12px;
}

QFileDialog QHeaderView::section:hover {
    background-color: #263449;
    color: #FFFFFF;
}

QFileDialog QAbstractScrollArea::corner {
    background-color: transparent;
    border: none;
}

QFileDialog QToolButton {
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 6px;
    min-width: 28px;
    min-height: 28px;
}

QFileDialog QToolButton:hover {
    background-color: #334155;
    border: 1px solid #6366F1;
}

QFileDialog QToolButton:pressed {
    background-color: #4F46E5;
}

QFileDialog QToolButton:disabled {
    background-color: rgba(30, 41, 59, 0.35);
    border: 1px solid rgba(51, 65, 85, 0.35);
}

QFileDialog QSplitter::handle {
    background-color: transparent;
    width: 8px;
}

QFileDialog QPushButton {
    background-color: #334155;
    color: #F1F5F9;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 8px 20px;
    font-size: 13px;
    font-weight: 600;
    min-width: 90px;
}

QFileDialog QPushButton:hover {
    background-color: #4F46E5;
    border: 1px solid #6366F1;
    color: #FFFFFF;
}

QFileDialog QPushButton:default {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #4F46E5, stop:1 #6366F1);
    border: none;
    color: #FFFFFF;
    font-weight: 700;
}

/* Action Buttons in Tables */
QPushButton#DeleteButton:hover {
    background-color: rgba(244, 63, 94, 0.22);
    border: 1px solid #F43F5E;
}

/* Custom Radio Button Styling */
QRadioButton {
    spacing: 10px;
    color: #F1F5F9;
    font-size: 13px;
    font-weight: 500;
    background: transparent;
    min-height: 26px;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 10px;
    border: 2px solid #475569;
    background-color: #0F172A;
}

QRadioButton::indicator:hover {
    border: 2px solid #6366F1;
}

QRadioButton::indicator:checked {
    width: 8px;
    height: 8px;
    border-radius: 10px;
    border: 6px solid #6366F1;
    background-color: #FFFFFF;
}

/* Custom Checkbox Styling */
QCheckBox {
    spacing: 10px;
    color: #F1F5F9;
    font-size: 13px;
    font-weight: 500;
    min-height: 26px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    border: 2px solid #475569;
    background-color: #0F172A;
}

QCheckBox::indicator:hover {
    border: 2px solid #6366F1;
}

QCheckBox::indicator:checked {
    background-color: #6366F1;
    border: 2px solid #6366F1;
    image: url("__ICONS_DIR__/check.svg");
}

/* Tab Close Button */
QTabBar::close-button {
    image: url("__ICONS_DIR__/close-sm.svg");
    background: transparent;
    border-radius: 9px;
    subcontrol-position: right;
    margin: 4px;
    width: 18px;
    height: 18px;
}

QTabBar::close-button:hover {
    background-color: #F43F5E;
}

/* ToolTip Styling */
QToolTip {
    background-color: #1E293B;
    color: #F1F5F9;
    border: 1px solid #475569;
    border-radius: 6px;
    padding: 6px 8px;
    font-size: 12px;
}

/* Custom QTabWidget Styling */
QTabWidget::pane {
    border: 1px solid rgba(255, 255, 255, 0.08);
    background-color: transparent;
    border-radius: 12px;
    top: -1px;
}

QTabBar::tab {
    background-color: #0F172A;
    color: #94A3B8;
    border: 1px solid #334155;
    border-bottom-color: transparent;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    padding: 8px 16px;
    min-height: 22px;
    font-weight: 600;
    margin-right: 4px;
    font-size: 13px;
}

QTabBar::tab:hover {
    background-color: #1E293B;
    color: #FFFFFF;
}

QTabBar::tab:selected {
    background-color: #1E293B;
    color: #818CF8;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-bottom: 2px solid #6366F1;
}
